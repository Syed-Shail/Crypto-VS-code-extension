{
  "name": "crypto-detector",
  "displayName": "Crypto Inventory & Migration Readiness",
  "description": "Local cryptographic discovery with source evidence, classical status, quantum migration signals, and CycloneDX CBOM export.",
  "version": "4.1.0",
  "publisher": "syedshail",
  "repository": {
    "type": "git",
    "url": "https://github.com/Syed-Shail/Crypto-VS-code-extension"
  },
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other",
    "Programming Languages",
    "Linters"
  ],
  "keywords": [
    "cryptography",
    "security",
    "quantum",
    "cbom",
    "cli",
    "code-analysis"
  ],
  "main": "./out/extension.js",
  "bin": {
    "crypto-detector": "./out/cli.js"
  },
  "activationEvents": [
    "onCommand:crypto-detector.scan-file",
    "onCommand:crypto-detector.scan-workspace",
    "onCommand:crypto-detector.scan-github",
    "onCommand:crypto-detector.export-cbom",
    "onCommand:crypto-detector.show-dashboard"
  ],
  "contributes": {
    "commands": [
      {
        "command": "crypto-detector.scan-file",
        "title": "Crypto Detector: Scan Current File",
        "category": "Crypto Detector",
        "icon": "$(search)"
      },
      {
        "command": "crypto-detector.scan-workspace",
        "title": "Crypto Detector: Scan Entire Workspace",
        "category": "Crypto Detector",
        "icon": "$(folder)"
      },
      {
        "command": "crypto-detector.scan-github",
        "title": "Crypto Detector: Scan GitHub Repository",
        "category": "Crypto Detector",
        "icon": "$(github)"
      },
      {
        "command": "crypto-detector.export-cbom",
        "title": "Crypto Detector: Export CBOM",
        "category": "Crypto Detector",
        "icon": "$(package)"
      },
      {
        "command": "crypto-detector.show-dashboard",
        "title": "Crypto Detector: Show Dashboard",
        "category": "Crypto Detector",
        "icon": "$(graph)"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "crypto-detector.scan-file",
          "when": "editorTextFocus",
          "group": "crypto-detector"
        }
      ],
      "explorer/context": [
        {
          "command": "crypto-detector.scan-workspace",
          "group": "crypto-detector"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./ && npm run copy-resources",
    "copy-resources": "node scripts/copy-resources.js",
    "postcompile": "node scripts/fix-shebang.js",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile",
    "test": "vscode-test",
    "package": "vsce package",
    "publish": "vsce publish",
    "download-grammars": "node scripts/copy-wasms.js",
    "setup": "npm run download-grammars && npm run compile",
    "test:unit": "node --test test/",
    "benchmark": "node scripts/benchmark.js"
  },
  "devDependencies": {
    "@types/node": "^18.19.130",
    "@types/vscode": "^1.80.0",
    "@vscode/vsce": "^2.22.0",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@octokit/rest": "^20.0.2",
    "chart.js": "^4.5.1",
    "commander": "^11.1.0",
    "simple-git": "^3.30.0",
    "tree-sitter-wasms": "^0.1.13",
    "web-tree-sitter": "^0.20.8"
  },
  "license": "MIT"
}
